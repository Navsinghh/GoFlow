{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      // Turborepo only passes declared variables to tasks. These end up in the build output...
      "env": ["BETTER_AUTH_URL", "NEXT_PUBLIC_*"],
      // ...and these are only read at runtime, but the build validates them (apps/web/lib/env.ts).
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "COLLAB_SECRET",
        "COLLAB_INTERNAL_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET"
      ]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": {},
    "test": { "passThroughEnv": ["TEST_DATABASE_URL", "COLLAB_TEST_DATABASE_URL"] }
  }
}

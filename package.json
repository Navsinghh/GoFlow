{
  "name": "flowcraft",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @flowcraft/db db:generate",
    "db:migrate": "pnpm --filter @flowcraft/db db:migrate",
    "db:migrate:neon": "pnpm --filter @flowcraft/db db:migrate:neon"
  },
  "devDependencies": {
    "@neon/config": "1.9.2",
    "@neon/env": "1.6.3",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}

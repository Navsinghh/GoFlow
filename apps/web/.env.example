# Postgres. For a local Unix-socket connection: postgres://USER@localhost/flowcraft?host=/var/run/postgresql
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowcraft
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Without a key, magic links are printed to the dev server's terminal.
RESEND_API_KEY=
EMAIL_FROM="Flowcraft <onboarding@resend.dev>"

# Optional OAuth providers; each button appears once its credentials are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Real-time collaboration server (apps/collab). Secret must match apps/collab/.env.
COLLAB_SECRET=
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
# Server-to-server address of the collab server (for pushing activity events).
COLLAB_INTERNAL_URL=http://localhost:1234
